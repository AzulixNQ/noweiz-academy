# Noweiz Academy
Options -Indexes
RewriteEngine On

# Le contrôle du certificat HTTPS (Let's Encrypt) passe tel quel
RewriteRule ^\.well-known/ - [L]

# L'ancienne adresse de test renvoie vers l'adresse définitive (mêmes pages)
RewriteCond %{HTTP_HOST} ^test\.noweiz\.com$ [NC]
RewriteRule ^(.*)$ https://academy.noweiz.com/$1 [R=301,L]

# Ce dossier est rangé dans celui du HUB : il ne répond que sous l'adresse du site de la formation
RewriteCond %{HTTP_HOST} !^academy\.noweiz\.com$ [NC]
RewriteRule ^ - [R=404,L]

# Toujours en HTTPS
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Ce qui ne se lit pas depuis le web : le code, les données, les outils, les fichiers cachés (.git…)
RewriteRule ^(app|donnees|outils)(/|$) - [F,L]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(LISEZMOI\.md|README\.md)$ - [F,L]

# Les vrais fichiers (style, police, icône) sont servis tels quels ; tout le reste passe par index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(css|js|woff2|svg|webp|png|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
